{
  "name": "garss-review-tools",
  "private": true,
  "scripts": {
    "build:review-schema": "node scripts/generate-review-validator.mjs",
    "check:review-schema": "node scripts/generate-review-validator.mjs --check",
    "test": "node --test --test-isolation=none tests/review.test.cjs tests/reader.test.cjs tests/review-inclusion.test.cjs tests/manual-sources.test.cjs",
    "review:check": "node scripts/apply-reviews.mjs --check",
    "review:apply": "node scripts/apply-reviews.mjs --apply",
    "preview": "python scripts/preview.py"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.2"
  }
}
